---
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import Breadcrumbs from './Breadcrumbs.astro';

export interface CollegeDomain {
  title: string;
  items: string[];
  tone: 'blue' | 'purple' | 'emerald';
}

export interface CollegePoint {
  title: string;
  text: string;
}

interface Props {
  slug: string;
  levelLabel: string;
  title: string;
  description: string;
  h1: string;
  subtitle: string;
  intro: string;
  domaines: CollegeDomain[];
  objectifs: CollegePoint[];
  pointsCles: CollegePoint[];
}

const {
  slug,
  levelLabel,
  title,
  description,
  h1,
  subtitle,
  intro,
  domaines,
  objectifs,
  pointsCles,
} = Astro.props;

const toneClass = {
  blue: { box: 'bg-blue-50 border-blue-200', title: 'text-blue-900' },
  purple: { box: 'bg-purple-50 border-purple-200', title: 'text-purple-900' },
  emerald: { box: 'bg-emerald-50 border-emerald-200', title: 'text-emerald-900' },
};

const otherLevels = [
  { href: '/6eme', label: '6ème' },
  { href: '/5eme', label: '5ème' },
  { href: '/4eme', label: '4ème' },
  { href: '/3eme', label: '3ème' },
].filter((level) => level.href !== `/${slug}`);
---

<Layout title={title} description={description}>
  <Header />

  <section class="bg-white pt-6">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <Breadcrumbs items={[{ label: `Maths ${levelLabel}` }]} />
      </div>
    </div>
  </section>

  <section class="relative bg-gradient-to-b from-blue-50 via-blue-50/50 to-white py-12 md:py-16 overflow-hidden">
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div class="absolute top-20 right-10 w-72 h-72 bg-cyan-200/30 rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-20 w-96 h-96 bg-purple-200/20 rounded-full blur-3xl"></div>
    </div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4 tracking-tight">
          {h1}
        </h1>
        <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed mb-8">
          {subtitle}
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="/#contact"
            class="inline-flex items-center justify-center px-6 py-3 bg-gray-900 text-white font-semibold rounded-xl hover:bg-gray-800 transition-colors"
          >
            Demander un entretien
          </a>
          <a
            href="/cours-paris"
            class="inline-flex items-center justify-center px-6 py-3 bg-white text-gray-900 font-semibold border-2 border-gray-900 rounded-xl hover:bg-gray-50 transition-colors"
          >
            Cours à Paris
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white py-12 md:py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <p class="text-base md:text-lg text-gray-700 leading-relaxed mb-12" set:html={intro} />

        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6">
          Programme de mathématiques en {levelLabel}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
          {domaines.map((domaine) => (
            <div class={`rounded-lg p-6 border ${toneClass[domaine.tone].box}`}>
              <h3 class={`text-lg font-semibold mb-3 ${toneClass[domaine.tone].title}`}>
                {domaine.title}
              </h3>
              <ul class="text-sm text-gray-700 space-y-2">
                {domaine.items.map((item) => (
                  <li>• {item}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6">
          Objectifs des cours particuliers
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
          {objectifs.map((objectif) => (
            <div class="bg-white border border-gray-200 rounded-lg p-6">
              <h3 class="font-semibold text-gray-900 mb-2">{objectif.title}</h3>
              <p class="text-gray-700 text-sm leading-relaxed">{objectif.text}</p>
            </div>
          ))}
        </div>

        <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6">
          Points à consolider
        </h2>
        <div class="space-y-6 mb-12">
          {pointsCles.map((point) => (
            <div>
              <h3 class="font-semibold text-gray-900 mb-2">{point.title}</h3>
              <p class="text-gray-700 text-sm leading-relaxed">{point.text}</p>
            </div>
          ))}
        </div>

        <div class="bg-blue-50 border-l-4 border-blue-600 rounded-lg p-6 md:p-8 mb-12">
          <h2 class="text-xl md:text-2xl font-bold text-gray-900 mb-4">
            Besoin d’aide en maths {levelLabel} ?
          </h2>
          <p class="text-gray-700 leading-relaxed mb-4">
            J’accompagne les élèves de {levelLabel} à domicile à Paris ou en visioconférence. L’entretien sert à voir le niveau, les lacunes et le rythme possible, avant de commencer.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href="/#contact"
              class="inline-flex items-center justify-center px-6 py-3 bg-gray-900 text-white font-semibold rounded-xl hover:bg-gray-800 transition-colors"
            >
              Demander un entretien
            </a>
            <a
              href="/cours-maths-visio"
              class="inline-flex items-center justify-center px-6 py-3 bg-white text-blue-700 font-semibold border-2 border-blue-600 rounded-xl hover:bg-blue-50 transition-colors"
            >
              Cours en visio
            </a>
          </div>
        </div>

        <p class="text-sm text-gray-600 mb-3">Autres niveaux du collège</p>
        <div class="flex flex-wrap gap-3">
          {otherLevels.map((level) => (
            <a
              href={level.href}
              class="px-4 py-2 rounded-lg border border-gray-200 text-gray-800 text-sm font-medium hover:border-gray-400 hover:bg-gray-50 transition-colors"
            >
              Maths {level.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
